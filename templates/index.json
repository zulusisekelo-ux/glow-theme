    "compare": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "\n<div class=\"glow-sec\">\n  <h2 class=\"glow-h2\">Dentist whitening vs GLOW</h2>\n  <p class=\"glow-sub\">Same job. Very different bill.</p>\n  <div class=\"glow-cmp\">\n    <div class=\"glow-card glow-card--muted\">\n      <div class=\"glow-card__tag\">At the dentist</div>\n      <ul>\n        <li><span>R3,500 – R8,000</span></li>\n        <li>Multiple appointments</li>\n        <li>Time off work</li>\n        <li>Booked weeks ahead</li>\n      </ul>\n    </div>\n    <div class=\"glow-card glow-card--hero\">\n      <div class=\"glow-card__tag glow-card__tag--on\">With GLOW</div>\n      <ul>\n        <li><span>R649 once</span></li>\n        <li>At home, on your schedule</li>\n        <li>30 minutes a session</li>\n        <li>Free delivery · 30-day guarantee</li>\n      </ul>\n      <a class=\"glow-btn\" href=\"/products/glow-professional-led-teeth-whitening-kit\">Get Your GLOW Kit</a>\n    </div>\n  </div>\n</div>\n<style>\n.glow-sec{max-width:1100px;margin:0 auto;padding:12px 20px 8px;font-family:inherit}\n.glow-h2{text-align:center;font-size:clamp(2.4rem,4vw,4rem);margin:0 0 6px;color:#2C3E50;letter-spacing:-.02em}\n.glow-sub{text-align:center;color:#6b7a89;margin:0 0 34px;font-size:1.7rem}\n.glow-cmp{display:grid;grid-template-columns:1fr 1fr;gap:22px}\n@media(max-width:749px){.glow-cmp{grid-template-columns:1fr}}\n.glow-card{border-radius:16px;padding:30px 28px;background:#fff;border:1px solid rgba(44,62,80,.10)}\n.glow-card--muted{opacity:.92}\n.glow-card--hero{background:linear-gradient(160deg,#4A90E2 0%,#2E5C8A 100%);color:#fff;border:0;\n  box-shadow:0 18px 40px rgba(74,144,226,.30)}\n.glow-card__tag{display:inline-block;font-size:1.25rem;letter-spacing:.10em;text-transform:uppercase;\n  color:#6b7a89;margin-bottom:16px;font-weight:600}\n.glow-card__tag--on{color:#fff;opacity:.9}\n.glow-card ul{list-style:none;margin:0;padding:0}\n.glow-card li{padding:11px 0;border-bottom:1px solid rgba(44,62,80,.09);font-size:1.65rem}\n.glow-card--hero li{border-bottom:1px solid rgba(255,255,255,.20)}\n.glow-card li:last-of-type{border-bottom:0}\n.glow-card li span{font-size:2.4rem;font-weight:700;letter-spacing:-.01em}\n.glow-btn{display:inline-block;margin-top:22px;background:#fff;color:#2E5C8A;text-decoration:none;\n  padding:14px 30px;border-radius:8px;font-weight:700;font-size:1.6rem}\n.glow-btn:hover{opacity:.92}\n</style>\n",
        "color_scheme": "scheme-2",
        "padding_top": 52,
        "padding_bottom": 52
      }
    }
