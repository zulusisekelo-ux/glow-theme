{% doc %}
  @prompt
    insert GLOW Partner Device, GLOW V34 Colour Corrector, GLOW Whitening Gel - 3 Syringes, GLOW Whitening Pen - 2
    Pack in a row right under the GLOW Professional LED
    Teeth Whitening Kit
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-partner-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-partner-products-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-partner-products-{{ ai_gen_id }}__card {
    min-width: 0;
    text-align: {{ block.settings.text_alignment }};
    text-decoration: none;
    color: inherit;
  }

  .ai-partner-products-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f4f4f4;
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-partner-products-{{ ai_gen_id }}__media img,
  .ai-partner-products-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-partner-products-{{ ai_gen_id }}__card:hover .ai-partner-products-{{ ai_gen_id }}__media img {
    opacity: 0.88;
  }

  .ai-partner-products-{{ ai_gen_id }}__title {
    margin: 12px 0 5px;
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.25;
    font-weight: 700;
  }

  .ai-partner-products-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-partner-products-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstyle %}

<div class="ai-partner-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-partner-products-{{ ai_gen_id }}__grid">
    {% for product in block.settings.products %}
      {% if product != blank %}
        <a class="ai-partner-products-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
          <div class="ai-partner-products-{{ ai_gen_id }}__media">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <h3 class="ai-partner-products-{{ ai_gen_id }}__title">{{ product.title }}</h3>
          <p class="ai-partner-products-{{ ai_gen_id }}__price">{{ product.price | money }}</p>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "GLOW partner products",
  "settings": [
    {
      "type": "product_list",
      "id": "products",
      "label": "Partner products",
      "limit": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Spacing",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2C3E50"
    }
  ],
  "presets": [
    {
      "name": "GLOW partner products"
    }
  ],
  "tag": null,
  "class": "glow-partner-products"
}
{% endschema %}